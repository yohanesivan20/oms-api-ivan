    },
    "components": {
        "schemas": {
            "PaymentWebhookRequest": {
                "type": "object",
                "properties": {
                    "payment_reference": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    }
                },
                "required": [
                    "payment_reference",
                    "status"
                ],
                "title": "PaymentWebhookRequest"
            },
            "StoreOrderRequest": {
                "type": "object",
                "properties": {
                    "customer_name": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "customer_email": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 255
                    },
                    "items": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "product_id": {
                                    "type": "integer",
                                    "minimum": 1
                                },
                                "quantity": {
                                    "type": "integer",
                                    "minimum": 1
                                }
                            },
                            "required": [
                                "product_id",
                                "quantity"
                            ]
                        },
                        "minItems": 1
                    }
                },
                "required": [
                    "customer_name",
                    "customer_email",
                    "items"
                ],
                "title": "StoreOrderRequest"
            },
            "StoreShipmentRequest": {
                "type": "object",
                "properties": {
                    "origin": {
                        "type": "string"
                    },
                    "destination": {
                        "type": "string"
                    },
                    "weight": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "courier": {
                        "type": "string"
                    }
                },
                "required": [
                    "origin",
                    "destination",
                    "weight",
                    "courier"
                ],
                "title": "StoreShipmentRequest"
            }
        },
        "responses": {
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            }
        }
    }
}